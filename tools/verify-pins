#!/usr/bin/env bash
set -euo pipefail

usage() {
    echo "usage: verify-pins [path]   (default: config/pins)"
}

REQUIRED_KEYS="chromium.version chromium.commit gsutil.version gsutil.commit"

case "${1-}" in
    -h|--help) usage; exit 0 ;;
esac

pins_path="${1-config/pins}"

if [ ! -f "$pins_path" ]; then
    echo "verify-pins: no pin file at $pins_path" >&2
    exit 2
fi

errors=0
seen=" "
lineno=0

fail() {
    echo "verify-pins: $pins_path:$1: $2" >&2
    errors=$((errors + 1))
}

while IFS= read -r line || [ -n "$line" ]; do
    lineno=$((lineno + 1))

    [ -z "${line//[[:space:]]/}" ] && continue

    if [[ ! "$line" =~ ^([a-z0-9_]+(\.[a-z0-9_]+)+)" = "(.+)$ ]]; then
        fail "$lineno" "malformed line, expected '<key> = <value>': $line"
        continue
    fi

    key="${BASH_REMATCH[1]}"
    value="${BASH_REMATCH[3]}"

    case "$seen" in
        *" $key "*) fail "$lineno" "duplicate key: $key"; continue ;;
    esac
    seen="$seen$key "

    case " $REQUIRED_KEYS " in
        *" $key "*) ;;
        *) fail "$lineno" "unknown key: $key"; continue ;;
    esac

    case "$key" in
        *.commit)
            if [[ ! "$value" =~ ^[0-9a-f]{40}$ ]]; then
                fail "$lineno" "$key must be a 40-character lowercase hex commit, got: $value"
            fi
            ;;
        *.version)
            if [[ ! "$value" =~ ^[0-9]+(\.[0-9]+)*$ ]]; then
                fail "$lineno" "$key must be a dotted numeric version, got: $value"
            fi
            ;;
    esac
done < "$pins_path"

for key in $REQUIRED_KEYS; do
    case "$seen" in
        *" $key "*) ;;
        *) echo "verify-pins: $pins_path: missing required key: $key" >&2; errors=$((errors + 1)) ;;
    esac
done

if [ "$errors" -ne 0 ]; then
    echo "verify-pins: FAILED with $errors error(s)" >&2
    exit 1
fi

count=$(echo "$REQUIRED_KEYS" | wc -w | tr -d ' ')
echo "verify-pins: OK — $count pins verified in $pins_path"
